---
import '@fontsource/funnel-sans/400.css';
import '@fontsource/funnel-sans/500.css';
import '@fontsource/funnel-sans/600.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';

const REPO = 'https://github.com/zanaat-dev/baron';
const NPM = 'https://www.npmjs.com/package/@zanaat/baron-mcp-server';
const DOCS = '/docs/getting-started/';
const ITEM = { id: 'STORE-142', title: 'Add rate limiting to the login endpoint' };

// Each board shows the tracker's own column names; the card sits in the one its team mapped to
// in_progress. Illustrative boards, drawn here, not screenshots of the products.
const boards = [
  { id: 'azure', name: 'Azure DevOps', short: 'DevOps', cols: ['New', 'Active', 'Test'], hit: 1 },
  { id: 'jira', name: 'Jira', short: 'Jira', cols: ['To Do', 'In Progress', 'In Review'], hit: 1 },
  {
    id: 'linear',
    name: 'Linear',
    short: 'Linear',
    cols: ['Todo', 'In Progress', 'In Review'],
    hit: 1,
  },
  {
    id: 'github',
    name: 'GitHub',
    short: 'GitHub',
    cols: ['open', 'label: in-progress', 'labels'],
    hit: 1,
  },
];
const ROLES = ['backlog', 'ready', 'in_progress', 'in_review', 'done'];
// The Azure row is a real team's mapping, named anonymously; the rest are Baron's example maps.
const MAPPINGS = [
  { name: 'Azure DevOps', note: 'a real team', states: ['New', '—', 'Active', 'Test', 'Closed'] },
  { name: 'Jira', note: 'example', states: ['To Do', '—', 'In Progress', 'In Review', 'Done'] },
  {
    name: 'Linear',
    note: 'example',
    states: ['Backlog', '—', 'In Progress', 'Code Review', 'Done'],
  },
  {
    name: 'GitHub',
    note: 'example',
    states: ['open', '—', 'label: in-progress', 'label: in-review', 'closed'],
  },
];
const GAPS = [
  {
    mode: 'error',
    text: 'Stop with an actionable message. A board column the item cannot take is refused before anything is written.',
  },
  {
    mode: 'emulate:labels',
    text: 'Synthesize it. GitHub has no native parent and child, so the hierarchy rides a `parent:<id>` label.',
  },
  {
    mode: 'degrade',
    text: 'Skip it and log a warning. A sprint asked of a tracker without sprints is skipped, and the warning says so.',
  },
];
const RECIPES = [
  { name: 'task-new', does: 'Files the item with its type and parent.' },
  {
    name: 'task-start',
    does: 'Cuts the canonical branch, moves the item to `in_progress`, assigns you.',
  },
  {
    name: 'task-finish',
    does: 'Opens a draft PR linked to the item, and says so if the link did not land.',
  },
  {
    name: 'task-land',
    does: 'Refuses red or pending checks, takes the PR out of draft, merges it.',
  },
];
// Prose strings mark machine words with backticks; `marked` sets those in mono.
const marked = (text: string) => text.split('`').map((part, i) => ({ part, code: i % 2 === 1 }));
// One entry per printed line; steps are nested under the heading so a wrapped step hangs under its text.
const TRANSCRIPT = [
  { text: 'Baron  ▸ runs the task-start recipe as a single call:', step: false },
  { text: `✓ Loaded ${ITEM.id} "${ITEM.title}"  (type role: task)`, step: true },
  {
    text: '✓ Checked it: not done, has a canonical branch, not assigned to someone else',
    step: true,
  },
  { text: `✓ Branched feature/${ITEM.id} from the repo's default branch`, step: true },
  { text: `✓ Moved ${ITEM.id} → in_progress, assigned to you`, step: true },
  { text: `✓ Commented on the item: "Started work — on branch feature/${ITEM.id}."`, step: true },
];
// The same four steps task-start runs, as the agent reports them.
const replies = [
  `Branched feature/${ITEM.id}`,
  `Moved ${ITEM.id} to in_progress`,
  'Assigned to you',
  'Commented on the item',
];
const TITLE = 'Baron: let your coding agent write to your work tracker';
const DESCRIPTION =
  'Baron is an open-source layer that turns issues, branches, pull requests, CI runs and deployments into one contract, across Azure DevOps, GitHub, Jira, Linear and Slack.';
const CANONICAL = new URL('/', Astro.site).href;
// The share card is the hero itself, captured once (see DESIGN.md): previews are the one place the
// scene ships as a raster, since link unfurlers do not run the page.
const SHARE_IMAGE = new URL('/og.png', Astro.site).href;
const SHARE_ALT =
  'Baron: an agent session starts STORE-142, and the same card lights up in Azure DevOps, Jira, Linear and GitHub.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="canonical" href={CANONICAL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Baron" />
    <meta property="og:url" content={CANONICAL} />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:image" content={SHARE_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SHARE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={SHARE_IMAGE} />
    <meta name="twitter:image:alt" content={SHARE_ALT} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="stage">
      <header class="nav">
        <a class="wordmark" href="/" aria-label="Baron home">baron</a>
        <nav class="links" aria-label="Primary">
          <a href={DOCS}>Docs</a>
          <a href={REPO}>GitHub</a>
          <a href={NPM}>npm</a>
        </nav>
        <a class="cta" href={DOCS}>Get started</a>
      </header>

      <section class="hero" aria-labelledby="hero-title">
        <h1 id="hero-title"><span>Let your coding agent</span> <span>write to your work tracker.</span></h1>
        <p class="subhead">Your agent speaks roles. Baron speaks Azure DevOps, GitHub, Jira and Linear.</p>
        <div class="actions">
          <div class="command">
            <code id="init-cmd">npx @zanaat/baron-cli init</code>
            <button type="button" class="copy" data-copy="init-cmd" aria-label="Copy the init command" title="Copy">
              <svg class="i-copy" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><rect x="5" y="5" width="9" height="9" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"></rect><path d="M11 3.5V3a1.5 1.5 0 0 0-1.5-1.5h-6A1.5 1.5 0 0 0 2 3v6A1.5 1.5 0 0 0 3.5 10.5H4" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
              <svg class="i-done" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </button>
          </div>
          <a class="docs-link" href={DOCS}>Read the docs</a>
        </div>
        <p class="license">Open source · Apache-2.0</p>
      </section>

      <figure class="scene" aria-label={`An agent starts ${ITEM.id}; the same card moves in four trackers.`}>
        <div class="scene-inner">
        <div class="agent">
          <p class="agent-title">Agent session</p>
          <p class="user-msg">Start work on {ITEM.id}</p>
          <div class="reply">
            <span class="avatar" aria-hidden="true"></span>
            <ul>
              {replies.map((r) => (
                <li>
                  <svg viewBox="0 0 16 16" width="10" height="10" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                  {r}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="boards" aria-hidden="true">
          {boards.map((b) => (
            <div class={`board board-${b.id}`}>
              <div class="board-head">
                <span>{b.short}</span>
                <span class="head-ghost"></span>
              </div>
              <div class="cols">
                {b.cols.map((c, ci) => (
                  <div class:list={['col', { hit: ci === b.hit }]}>
                    <span class="col-name">{c}</span>
                    {ci === b.hit && (
                      <span class="col-card">
                        <span class="card-id">{ITEM.id}</span>
                        <span class="card-title">{ITEM.title}</span>
                      </span>
                    )}
                    <span class="ghost"><i></i></span>
                    <span class="ghost short"><i></i></span>
                    <span class="ghost"><i></i></span>
                  </div>
                ))}
              </div>
              <span class="board-label">{b.name}</span>
            </div>
          ))}
          {boards.map((b) => (
            <div class={`card card-${b.id}`}>
              <span class="card-id">{ITEM.id}</span>
              <span class="card-title">{ITEM.title}</span>
            </div>
          ))}
          <div class="card card-moving">
            <span class="card-id">{ITEM.id}</span>
            <span class="card-title">{ITEM.title}</span>
          </div>
          <canvas class="traces"></canvas>
        </div>
        </div>
      </figure>

    </div>

    <main class="flow" id="main">
      <section class="panel contract" aria-labelledby="contract-title">
        <div class="lede">
          <h2 id="contract-title">One contract. Every tracker.</h2>
          <p>
            The agent asks for a role. Each tracker gets its own state. Your team confirms the mapping once,
            at <code>baron init</code>, and commits it with the repo, so the model never guesses it again.
          </p>
        </div>
        <div class="table-wrap">
          <table class="roles">
            <caption>How one role lands in four trackers</caption>
            <thead>
              <tr>
                <th scope="col">Tracker</th>
                {ROLES.map((r) => <th scope="col" class:list={{ on: r === 'in_progress' }}>{r}</th>)}
              </tr>
            </thead>
            <tbody>
              {MAPPINGS.map((m) => (
                <tr>
                  <th scope="row">{m.name}<span>{m.note}</span></th>
                  {m.states.map((s, i) => (
                    <td data-role={ROLES[i]} class:list={{ on: ROLES[i] === 'in_progress', none: s === '—' }}>{s}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="aside">
          A dash is a role that tracker leaves unmapped. Why a tracker cannot be normalized by mapping four states
          onto everything: <a href="https://dev.to/keparlak/you-cant-set-a-status-in-jira-4d7p">You can't set a status in Jira</a>.
        </p>
      </section>

      <section class="band" aria-labelledby="gaps-title">
        <h2 id="gaps-title">When a tracker can't, you hear about it.</h2>
        <p class="band-lede">Every capability gap is decided by a policy you set. None is dropped quietly.</p>
        <dl class="gaps">
          {GAPS.map((g) => (
            <div>
              <dt><code>{g.mode}</code></dt>
              <dd>{marked(g.text).map((m) => (m.code ? <code>{m.part}</code> : m.part))}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="band loop" aria-labelledby="loop-title">
        <div class="loop-text">
          <h2 id="loop-title">The daily loop is four calls.</h2>
          <p class="band-lede">
            Workflow lives in declarative recipes, not in prompts. Each runs as one journaled call that checks
            before it writes, and a run that stops halfway resumes where it stopped.
          </p>
          <ol class="recipes">
            {RECIPES.map((r) => (
              <li><code>{r.name}</code><span>{marked(r.does).map((m) => (m.code ? <code>{m.part}</code> : m.part))}</span></li>
            ))}
          </ol>
        </div>
        <figure class="transcript" aria-label="What task-start prints">
          <figcaption>You: Start work on {ITEM.id}.</figcaption>
          <pre><code>{TRANSCRIPT.map((l) => <span class:list={['line', { step: l.step }]}>{l.text}</span>)}</code></pre>
        </figure>
      </section>

      <section class="band install" aria-labelledby="install-title">
        <h2 id="install-title">Two ways in.</h2>
        <div class="paths">
          <div class="path">
            <div class="path-head">
              <h3>Claude Code plugin</h3>
              <button type="button" class="copy" data-copy="plugin-cmd" aria-label="Copy the plugin commands" title="Copy">
                <svg class="i-copy" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><rect x="5" y="5" width="9" height="9" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"></rect><path d="M11 3.5V3a1.5 1.5 0 0 0-1.5-1.5h-6A1.5 1.5 0 0 0 2 3v6A1.5 1.5 0 0 0 3.5 10.5H4" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
                <svg class="i-done" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </button>
            </div>
            <pre><code id="plugin-cmd">/plugin marketplace add <span class="nb">zanaat-dev/baron</span>
/plugin install baron@baron</code></pre>
          </div>
          <div class="path">
            <div class="path-head">
              <h3>Any MCP client</h3>
              <button type="button" class="copy" data-copy="mcp-cmd" aria-label="Copy the MCP server command" title="Copy">
                <svg class="i-copy" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><rect x="5" y="5" width="9" height="9" rx="2" fill="none" stroke="currentColor" stroke-width="1.4"></rect><path d="M11 3.5V3a1.5 1.5 0 0 0-1.5-1.5h-6A1.5 1.5 0 0 0 2 3v6A1.5 1.5 0 0 0 3.5 10.5H4" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
                <svg class="i-done" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
              </button>
            </div>
            <pre><code id="mcp-cmd">npx -y @zanaat/baron-mcp-server@latest</code></pre>
            <p>Listed in the official MCP Registry as <code class="nb">io.github.zanaat-dev/baron</code>.</p>
          </div>
        </div>
        <a class="docs-cta" href={DOCS}>Read the getting started guide</a>
      </section>
    </main>

    <footer class="foot">
      <span>Apache-2.0 · a <a href="https://zanaat.dev">zanaat</a> project</span>
      <nav aria-label="Footer">
        <a href={REPO}>GitHub</a>
        <a href={NPM}>npm</a>
        <a href="/llms.txt">llms.txt</a>
      </nav>
    </footer>

    <p class="sr-only" role="status" id="copy-status"></p>

    <script>
      const canvas = document.querySelector<HTMLCanvasElement>('.traces');
      const stage = document.querySelector<HTMLElement>('.stage');
      const agent = document.querySelector<HTMLElement>('.agent');
      const onScreen = () =>
        [...document.querySelectorAll<HTMLElement>('.card, .col-card')].filter((el) => el.getClientRects().length > 0);
      let targets = onScreen();

      // Traces are computed from where the cards actually render, so they stay attached at any width.
      // progress[i] is how much of trace i is drawn, 0..1.
      function draw(progress: number[] = targets.map(() => 1)) {
        if (!canvas || !stage || !agent) return;
        targets = onScreen();
        const box = canvas.getBoundingClientRect();
        const dpr = window.devicePixelRatio || 1;
        canvas.width = Math.round(box.width * dpr);
        canvas.height = Math.round(box.height * dpr);
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        ctx.scale(dpr, dpr);
        const a = agent.getBoundingClientRect();
        // On narrow screens the panel sits above the boards, so the light leaves from its lower edge.
        const above = a.bottom <= box.top + 1;
        const sx = above ? a.left + a.width * 0.5 - box.left : a.right - box.left;
        const sy = above ? 0 : a.top + a.height * 0.57 - box.top;
        targets.forEach((t, i) => {
          const p = progress[i] ?? 1;
          if (p <= 0) return;
          const r = t.getBoundingClientRect();
          const ex = r.left - box.left + r.width * 0.06;
          const ey = r.top - box.top + r.height * 0.55;
          const c1x = above ? sx : sx + (ex - sx) * 0.45;
          const c2x = above ? ex : ex - (ex - sx) * 0.35;
          const at = (u: number, a0: number, a1: number, a2: number, a3: number) =>
            (1 - u) ** 3 * a0 + 3 * (1 - u) ** 2 * u * a1 + 3 * (1 - u) * u ** 2 * a2 + u ** 3 * a3;
          const grad = ctx.createLinearGradient(sx, sy, ex, ey);
          grad.addColorStop(0, 'rgba(240, 168, 72, 0.95)');
          grad.addColorStop(1, 'rgba(232, 150, 58, 0.7)');
          ctx.strokeStyle = grad;
          ctx.lineWidth = 1.4;
          ctx.shadowColor = 'rgba(240, 160, 60, 0.75)';
          ctx.shadowBlur = 8;
          ctx.beginPath();
          ctx.moveTo(sx, sy);
          const steps = Math.max(2, Math.round(48 * p));
          for (let s = 1; s <= steps; s++) {
            const u = (s / steps) * p;
            const c1y = above ? sy + (ey - sy) * 0.5 : sy;
            const c2y = above ? ey - (ey - sy) * 0.3 : ey;
            ctx.lineTo(at(u, sx, c1x, c2x, ex), at(u, sy, c1y, c2y, ey));
          }
          ctx.stroke();
        });
      }

      // The one authored moment: the agent's reply travels out, trace by trace, and each card lights
      // as its trace arrives. Cards are visible from the start; only the light is animated.
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let settled = still;
      if (still) for (const t of document.querySelectorAll('.card, .col-card')) t.classList.add('lit');
      function play() {
        if (settled) return draw();
        const start = performance.now();
        const span = 900;
        const gap = 140;
        const ease = (x: number) => (x >= 1 ? 1 : 1 - 2 ** (-10 * x));
        const tick = (now: number) => {
          const progress = targets.map((_, i) => ease(Math.max(0, (now - start - i * gap) / span)));
          progress.forEach((p, i) => targets[i]?.classList.toggle('lit', p > 0.97));
          draw(progress);
          if (progress.every((p) => p >= 1)) {
            settled = true;
            return;
          }
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }
      window.addEventListener('resize', () => draw());
      (document.fonts?.ready ?? Promise.resolve()).then(play);

      // The buttons are icon-only, so the outcome is announced through one shared live region; when
      // the clipboard is refused the command is selected instead, ready for Ctrl+C.
      const status = document.getElementById('copy-status');
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        let reset = 0;
        button.addEventListener('click', async () => {
          const source = document.getElementById(button.dataset.copy ?? '');
          try {
            await navigator.clipboard.writeText(source?.textContent ?? '');
            button.dataset.state = 'done';
            if (status) status.textContent = 'Copied';
          } catch {
            if (source) window.getSelection()?.selectAllChildren(source);
            if (status) status.textContent = 'Copy is blocked here; the command is selected';
          }
          window.clearTimeout(reset);
          reset = window.setTimeout(() => {
            delete button.dataset.state;
            if (status) status.textContent = '';
          }, 1600);
        });
      }
    </script>

    <style is:global>
      :root {
        --ground: #0e0e0f;
        --ink: #ecebe5;
        --muted: #948d86;
        --quiet: #8a8580;
        --amber: #e8a13a;
        --sans: 'Funnel Sans', 'Segoe UI', system-ui, sans-serif;
        --mono: 'Geist Mono', ui-monospace, 'Cascadia Mono', Consolas, monospace;
        /* One comp pixel at the comp's 1024px width; the first viewport scales as a whole. */
        --u: calc(min(100vw, 1280px) / 1024);
        color-scheme: dark;
      }
      /*
       * The composition is 1024 x 687 comp units. It stops growing at 1280px, the reading width of the
       * category (a 2560px screen otherwise set a 75px headline), and it never grows taller than the
       * window, so the scene stays one first viewport on short laptop screens too. The 860px floor is
       * where the narrow layout takes over.
       */
      @media (min-width: 861px) {
        :root { --u: calc(clamp(860px, min(100vw, 1280px, 100svh * 1024 / 687), 1280px) / 1024); }
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; background: var(--ground); }
      html { scrollbar-color: #3a3937 var(--ground); }
      body { color: var(--ink); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
      ::selection { background: var(--amber); color: #111; }
      a { color: inherit; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; border-radius: 4px; }
      h1, h2, p { margin: 0; }
    </style>

    <style>
      /*
       * The stage spans the window and only clips at its edges, so the boards bleed off the screen
       * rather than ending against an invisible box; the composition is centred inside it. The light is
       * sized in comp units so it stays fixed to the scene instead of stretching with the window.
       */
      .stage {
        position: relative;
        width: 100%;
        height: calc(687 * var(--u));
        overflow: hidden;
        background:
          radial-gradient(calc(717 * var(--u)) calc(412 * var(--u)) at calc(50% + 164 * var(--u)) calc(41 * var(--u)), rgba(66, 65, 63, 0.8), transparent 72%),
          radial-gradient(calc(512 * var(--u)) calc(275 * var(--u)) at calc(50% - 205 * var(--u)) 0, rgba(54, 50, 46, 0.45), transparent 75%),
          var(--ground);
      }
      .stage > * { position: absolute; }
      .nav, .hero, .scene { left: calc(50% - 512 * var(--u)); width: calc(1024 * var(--u)); }
      /* A composited layer renders text with grayscale antialiasing, as the comp does, instead of colour-fringed subpixel text. */
      .stage { will-change: transform; }
      .nav, .hero, .agent { transform: translateZ(0); }

      .nav { top: 0; height: calc(58 * var(--u)); }
      .wordmark {
        position: absolute; left: calc(104 * var(--u)); top: calc(13 * var(--u));
        font-size: calc(27 * var(--u)); font-weight: 400; color: #dddbda; text-decoration: none; letter-spacing: -0.01em;
      }
      .links { position: absolute; left: calc(682 * var(--u)); top: calc(20 * var(--u)); display: flex; gap: calc(19 * var(--u)); }
      .links a { font-size: calc(13 * var(--u)); color: var(--quiet); text-decoration: none; font-weight: 500; }
      .links a:hover { color: var(--ink); }
      .cta {
        position: absolute; left: calc(833 * var(--u)); top: calc(15 * var(--u)); width: calc(86 * var(--u)); height: calc(29 * var(--u));
        display: grid; place-items: center; background: #3a3937; border: 1px solid #575551; border-radius: calc(7 * var(--u));
        font-size: calc(13 * var(--u)); color: #dcdcda; text-decoration: none; font-weight: 500;
      }
      .cta:hover { border-color: var(--amber); }

      .hero { top: 0; bottom: 0; pointer-events: none; }
      .hero > * { position: absolute; pointer-events: auto; }
      /* The license rides beside the docs link: the floor bans a label above the headline. */
      .license { left: calc(105 * var(--u)); top: calc(314 * var(--u)); font-size: calc(11.5 * var(--u)); color: var(--quiet); white-space: nowrap; }
      h1 span { display: block; }
      h1 {
        left: calc(104 * var(--u)); top: calc(124 * var(--u)); width: calc(560 * var(--u));
        font-size: calc(47 * var(--u)); line-height: 0.99; font-weight: 500; letter-spacing: -0.012em; color: var(--ink);
      }
      .subhead { left: calc(105 * var(--u)); top: calc(228 * var(--u)); font-size: calc(15.8 * var(--u)); color: var(--muted); white-space: nowrap; }
      /* The command and its docs link share one row, so the link keeps a real gap however wide the command sets. */
      .actions { left: calc(104 * var(--u)); top: calc(268 * var(--u)); display: flex; align-items: center; gap: calc(22 * var(--u)); }
      .command {
        height: calc(33 * var(--u)); display: flex; align-items: center; gap: calc(8 * var(--u));
        padding: 0 calc(5 * var(--u)) 0 calc(10 * var(--u));
        background: #171718; border: 1px solid #2f2f30; border-radius: calc(6 * var(--u));
      }
      .command code { font-family: var(--mono); font-size: calc(12.2 * var(--u)); color: #d4d4d2; white-space: nowrap; }
      .copy {
        flex: none; display: grid; place-items: center; width: calc(23 * var(--u)); height: calc(23 * var(--u));
        background: none; border: 0; padding: 0; border-radius: calc(5 * var(--u)); cursor: pointer; color: #8d8d8b;
        transition: color 0.15s ease-out, background-color 0.15s ease-out;
      }
      .copy svg { width: calc(12 * var(--u)); height: calc(12 * var(--u)); }
      .copy:hover { color: var(--ink); background: rgba(255, 255, 255, 0.06); }
      .copy .i-done, .copy[data-state='done'] .i-copy { display: none; }
      .copy[data-state='done'] .i-done { display: block; }
      .copy[data-state='done'] { color: var(--ink); }
      .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      .docs-link { font-size: calc(12.2 * var(--u)); color: #a3a3a0; text-underline-offset: calc(4 * var(--u)); text-decoration-thickness: calc(1.4 * var(--u)); }
      .docs-link:hover { color: var(--ink); }

      .scene { top: 0; bottom: 0; margin: 0; pointer-events: none; }
      .scene-inner { position: absolute; inset: 0; }
      .agent {
        position: absolute; left: calc(104 * var(--u)); top: calc(385 * var(--u)); width: calc(269 * var(--u)); height: calc(169 * var(--u));
        background: #1e1e1f; border: 1px solid #333335; border-radius: calc(8 * var(--u));
        box-shadow: 0 calc(18 * var(--u)) calc(40 * var(--u)) rgba(0, 0, 0, 0.45);
      }
      .agent-title { position: absolute; left: calc(10 * var(--u)); top: calc(7 * var(--u)); font-size: calc(11.5 * var(--u)); color: #9a9a9c; }
      .agent::before { content: ''; position: absolute; left: 0; right: 0; top: calc(25 * var(--u)); border-top: 1px solid #2b2b2d; }
      .user-msg {
        position: absolute; right: calc(9 * var(--u)); top: calc(37 * var(--u)); padding: calc(6 * var(--u)) calc(10 * var(--u));
        background: #38383a; border-radius: calc(8 * var(--u)); font-size: calc(11.5 * var(--u)); color: #d9d9d7;
      }
      .reply { position: absolute; left: calc(10 * var(--u)); top: calc(72 * var(--u)); display: flex; gap: calc(8 * var(--u)); }
      .avatar {
        flex: none; width: calc(18 * var(--u)); height: calc(18 * var(--u)); border-radius: 50%;
        background: radial-gradient(circle at 35% 30%, #5a5856, #2e2d2c); box-shadow: 0 0 0 1px #3c3b39;
      }
      .reply ul {
        list-style: none; margin: 0; padding: calc(7 * var(--u)) calc(10 * var(--u)); display: grid; gap: calc(4 * var(--u));
        background: #252527; border-radius: calc(5 * var(--u));
      }
      .reply li { display: flex; align-items: center; gap: calc(6 * var(--u)); font-size: calc(11.5 * var(--u)); color: #b9b9bb; white-space: nowrap; }
      .reply li svg { width: calc(9 * var(--u)); height: calc(9 * var(--u)); color: #9b9b9d; }

      .boards { position: absolute; inset: 0; perspective: calc(2400 * var(--u)); }
      .board, .card { position: absolute; transform-style: preserve-3d; }
      /* One shared tilt, so the four boards read as a single fanned stack. */
      .board {
        width: calc(360 * var(--u)); height: calc(170 * var(--u));
        background: linear-gradient(180deg, #252427, #1b1a1c 38%); border: 1px solid #343236; border-radius: calc(9 * var(--u));
        transform: translate(-50%, -50%) rotateX(48deg) rotateZ(-24deg) skewX(8deg);
        /* A lit top edge and a soft drop: one light source, from above. */
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.09), 0 calc(30 * var(--u)) calc(60 * var(--u)) rgba(0, 0, 0, 0.55);
      }
      .board-azure { left: calc(578 * var(--u)); top: calc(378 * var(--u)); z-index: 1; }
      .board-jira { left: calc(828 * var(--u)); top: calc(290 * var(--u)); z-index: 2; }
      .board-linear { left: calc(900 * var(--u)); top: calc(380 * var(--u)); z-index: 3; }
      /* Ends above the first panel: where the panel overlapped it, its lower edge read as cut. */
      .board-github { left: calc(830 * var(--u)); top: calc(507 * var(--u)); z-index: 4; }
      .board-head { display: flex; align-items: center; justify-content: space-between; gap: calc(6 * var(--u)); padding: calc(8 * var(--u)) calc(12 * var(--u)); margin-bottom: calc(8 * var(--u)); border-bottom: 1px solid #2c2b2e; background: rgba(255, 255, 255, 0.025); font-size: calc(10 * var(--u)); color: #d2d0cc; font-weight: 600; }
      .head-ghost { width: calc(46 * var(--u)); height: calc(7 * var(--u)); border-radius: calc(3 * var(--u)); background: #2e2d30; }
      .board-label { position: absolute; left: calc(4 * var(--u)); top: calc(-16 * var(--u)); font-size: calc(9 * var(--u)); color: var(--quiet); }
      .cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: calc(8 * var(--u)); padding: 0 calc(12 * var(--u)); }
      .col { display: grid; gap: calc(6 * var(--u)); align-content: start; }
      .col-name { font-size: calc(8.5 * var(--u)); color: #9a958f; }
      .ghost { display: flex; align-items: center; gap: calc(4 * var(--u)); height: calc(13 * var(--u)); padding: 0 calc(4 * var(--u)); border-radius: calc(3 * var(--u)); background: #262528; }
      .ghost::after { content: ''; flex: 1; height: calc(3 * var(--u)); border-radius: 2px; background: #343337; }
      .ghost i { width: calc(6 * var(--u)); height: calc(6 * var(--u)); border-radius: 50%; background: #3d3c40; }
      .ghost.short { width: 70%; }

      .card {
        width: calc(128 * var(--u)); padding: calc(7 * var(--u)) calc(9 * var(--u)); display: grid; gap: calc(2 * var(--u));
        background: linear-gradient(160deg, #2c2926, #24211f); border: calc(1.5 * var(--u)) solid rgba(176, 128, 66, 0.55); border-radius: calc(8 * var(--u));
        /* A transparent outline keeps the border smooth under the 3D transform instead of breaking into dashes. */
        outline: 1px solid transparent; backface-visibility: hidden;
        box-shadow: 0 0 calc(10 * var(--u)) rgba(200, 140, 60, 0.18);
        transition: border-color 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        transform: translate(-50%, -50%) rotateX(48deg) rotateZ(-24deg) skewX(8deg);
        z-index: 10;
      }
      /* Before its trace arrives a card sits a step dimmer; lit is the resting state the comp shows. */
      .boards .card:not(.lit) { border-color: rgba(176, 128, 66, 0.28); box-shadow: none; }
      .col-card { display: none; }
      .card-id { font-family: var(--mono); font-size: calc(7.5 * var(--u)); color: #a2958a; }
      .card-title { font-size: calc(9.5 * var(--u)); line-height: 1.15; color: #ebe6df; font-weight: 500; }
      .card-azure { left: calc(556 * var(--u)); top: calc(394 * var(--u)); }
      .card-jira { left: calc(778 * var(--u)); top: calc(336 * var(--u)); }
      .card-linear { left: calc(908 * var(--u)); top: calc(396 * var(--u)); }
      .card-github { left: calc(928 * var(--u)); top: calc(480 * var(--u)); }
      /* In transit toward GitHub, in front and readable, clear of that board's name and of the panel below. */
      .card-moving { left: calc(536 * var(--u)); top: calc(560 * var(--u)); }
      .traces { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 9; }

      /* Below the first viewport the page is ordinary flow, on the same column the hero uses. */
      .flow {
        position: relative; z-index: 2;
        width: calc(814 * var(--u)); margin: calc(-69 * var(--u)) auto 0;
        display: grid; gap: clamp(72px, calc(110 * var(--u)), 150px);
        padding-bottom: clamp(72px, calc(110 * var(--u)), 150px);
      }
      .flow h2 { font-size: clamp(26px, calc(30 * var(--u)), 44px); font-weight: 500; letter-spacing: -0.015em; line-height: 1.1; color: var(--ink); text-wrap: balance; }
      .flow code { font-family: var(--mono); font-size: 0.92em; color: #d8c9b2; }
      .flow a { color: #d8c9b2; text-underline-offset: 3px; }
      .flow a:hover { color: var(--amber); }

      .panel {
        background: #161616; border: 1px solid #262626; border-radius: calc(12 * var(--u));
        padding: calc(36 * var(--u)) calc(34 * var(--u)) calc(34 * var(--u));
        display: grid; gap: clamp(22px, calc(28 * var(--u)), 40px);
      }
      .lede { display: grid; gap: 14px; max-width: 62ch; }
      .lede p, .band-lede { font-size: clamp(16px, calc(16 * var(--u)), 21px); line-height: 1.55; color: var(--muted); max-width: 62ch; }

      .table-wrap { overflow-x: auto; border: 1px solid #262626; border-radius: 10px; }
      .roles { width: 100%; min-width: 640px; border-collapse: collapse; font-size: clamp(13px, calc(13 * var(--u)), 16px); }
      .roles caption { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
      .roles th, .roles td { padding: 14px 16px; text-align: left; border-bottom: 1px solid #222; white-space: nowrap; }
      .roles tbody tr:last-child > * { border-bottom: 0; }
      .roles thead th { font-family: var(--mono); font-weight: 500; font-size: 0.86em; color: #8d8984; background: #191919; }
      .roles thead th.on { color: var(--amber); }
      .roles tbody th { font-weight: 500; color: var(--ink); }
      .roles tbody th span { display: block; font-size: 0.78em; font-weight: 400; color: var(--quiet); margin-top: 2px; }
      .roles td { font-family: var(--mono); font-size: 0.92em; color: #a9a5a0; }
      .roles td.on { color: #f3d6ad; background: rgba(232, 161, 58, 0.08); box-shadow: inset 1px 0 rgba(232, 161, 58, 0.35), inset -1px 0 rgba(232, 161, 58, 0.35); }
      .roles td.none { color: var(--quiet); }
      .roles tbody tr:hover > * { background-color: #1b1b1b; }
      .roles tbody tr:hover > td.on { background: rgba(232, 161, 58, 0.12); }
      .aside { font-size: clamp(14px, calc(13.5 * var(--u)), 17px); color: var(--quiet); max-width: 72ch; }

      .band { display: grid; gap: 18px; }
      .band > .band-lede { margin-bottom: clamp(10px, calc(14 * var(--u)), 22px); }
      .gaps { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid #262626; }
      .gaps > div { padding: 22px 26px 4px 0; display: grid; gap: 10px; align-content: start; }
      .gaps > div + div { padding-left: 26px; border-left: 1px solid #222; }
      .gaps dt code { font-size: clamp(14px, calc(14 * var(--u)), 18px); color: var(--ink); }
      .gaps dd { margin: 0; font-size: clamp(15px, calc(14.5 * var(--u)), 18px); line-height: 1.55; color: var(--muted); }

      .loop { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(28px, calc(44 * var(--u)), 64px); align-items: start; }
      .loop-text { display: grid; gap: 18px; }
      .recipes { margin: 8px 0 0; padding: 0; list-style: none; display: grid; border-top: 1px solid #262626; }
      .recipes li { display: grid; grid-template-columns: 9.5em 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid #1f1f1f; font-size: clamp(15px, calc(14.5 * var(--u)), 18px); }
      .recipes li > code { color: var(--ink); }
      .recipes span { color: var(--muted); line-height: 1.5; }
      /* The transcript is shorter than the recipe list, so it stays in view while the list scrolls past. */
      .transcript {
        position: sticky; top: 32px; margin: 0; background: #1e1e1f; border: 1px solid #333335; border-radius: 10px; overflow: hidden;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
      }
      .transcript figcaption { padding: 11px 16px; border-bottom: 1px solid #2b2b2d; font-size: 14px; color: #9a9a9c; }
      /* Each line hangs: a wrapped heading continues 2ch in, a wrapped step continues under its text, past the check. */
      .transcript .line { display: block; padding-left: 2ch; text-indent: -2ch; }
      .transcript .step { margin-left: 2ch; }
      .transcript pre { margin: 0; padding: 18px; overflow-x: auto; white-space: pre-wrap; font-family: var(--mono); font-size: clamp(12.5px, calc(12.5 * var(--u)), 15px); line-height: 1.75; color: #b9b5ae; }

      .install h2 { margin-bottom: 8px; }
      .paths { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
      .path { background: #161616; border: 1px solid #262626; border-radius: 12px; padding: 22px 24px; display: grid; gap: 14px; align-content: start; min-width: 0; }
      .path h3 { margin: 0; font-size: 17px; font-weight: 500; color: var(--ink); }
      .path-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
      .path .copy { width: 30px; height: 30px; margin: -6px -8px -6px 0; border-radius: 6px; }
      .path .copy svg { width: 15px; height: 15px; }
      .path pre { white-space: pre-wrap; overflow-wrap: normal; }
      .path .nb { white-space: nowrap; }
      .path pre { margin: 0; overflow-x: auto; font-family: var(--mono); font-size: 14px; line-height: 1.75; color: #d4d4d2; }
      .path p { font-size: 15px; color: var(--muted); }
      .docs-cta {
        justify-self: start; margin-top: 10px; padding: 11px 18px; border-radius: 8px; text-decoration: none;
        background: #3a3937; border: 1px solid #575551; color: #ecebe5 !important; font-size: 15px; font-weight: 500;
      }
      .docs-cta:hover { border-color: var(--amber); }

      .skip {
        position: absolute; left: 16px; top: 12px; z-index: 20; padding: 9px 14px; border-radius: 8px;
        background: #3a3937; border: 1px solid #575551; color: var(--ink); font-size: 14px; font-weight: 500; text-decoration: none;
        transform: translateY(calc(-100% - 20px));
      }
      .skip:focus-visible { transform: none; }

      .foot {
        width: calc(814 * var(--u)); margin: 0 auto; padding: 26px 0 44px; border-top: 1px solid #222;
        display: flex; flex-wrap: wrap; gap: 10px 24px; justify-content: space-between; font-size: 14px; color: var(--quiet);
      }
      .foot nav { display: flex; gap: 20px; }
      .foot a { color: #8d8984; text-decoration: none; }
      .foot a:hover { color: var(--ink); }

      body { background: radial-gradient(ellipse 80% 50% at 60% 0%, rgba(54, 50, 46, 0.35), transparent 70%) var(--ground); }

      /*
       * Narrow screens: the copy returns to ordinary flow at reading sizes, and the scene keeps its
       * composition as a cropped figure underneath, scaled to the column. Below 860px the vw-scaled
       * hero would set the headline under 40px.
       */
      @media (max-width: 860px) {
        .stage { height: auto; display: grid; gap: 28px; padding: 18px 20px 0; overflow: visible; }
        .stage > * { position: static; }
        .nav, .hero, .scene { left: auto; width: auto; }
        .nav { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: auto; flex-wrap: wrap; }
        .wordmark, .links, .cta { position: static; }
        .wordmark { font-size: 24px; }
        .links { gap: 16px; margin-left: auto; }
        .links a { font-size: 14px; }
        .cta { width: auto; height: auto; padding: 7px 12px; font-size: 14px; border-radius: 7px; }
        .hero { display: grid; gap: 16px; justify-items: start; padding-top: 18px; }
        .hero > * { position: static; }
        h1 { width: auto; font-size: clamp(34px, 9.4vw, 52px); line-height: 1.02; }
        h1 span { display: inline; }
        .license { font-size: 14px; }
        .subhead { white-space: normal; font-size: 17px; line-height: 1.5; max-width: 34ch; }
        .actions { display: grid; gap: 16px; justify-items: start; width: 100%; }
        .command { width: 100%; max-width: 380px; height: 46px; justify-content: space-between; padding: 0 4px 0 14px; border-radius: 8px; }
        .command code { font-size: 14px; }
        .command .copy { width: 38px; height: 38px; border-radius: 6px; }
        .command .copy svg { width: 15px; height: 15px; }
        .docs-link { font-size: 15px; }
        /* The scene re-stages instead of shrinking: the agent panel at reading size, then a crop of
           the boards at the same scale, so card text stays at 11px or more. */
        .scene { position: relative; width: 100%; }
        .scene-inner { --u: 1.15px; position: relative; inset: auto; display: grid; gap: 14px; }
        .agent { position: relative; left: auto; top: auto; width: min(100%, calc(269 * var(--u))); }
        .boards { position: relative; inset: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding-top: 36px; perspective: none; }
        .boards > .card { display: none; }
        .board { position: relative; left: auto; top: auto; width: auto; height: auto; transform: none; padding-bottom: 10px; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.09); }
        .board-label { display: none; }
        .board-head { font-size: 13px; padding: 9px 10px; margin-bottom: 8px; }
        .head-ghost { width: 28px; height: 6px; }
        .cols { grid-template-columns: 1fr; padding: 0 10px; }
        .col:not(.hit) { display: none; }
        .col-name { font-family: var(--mono); font-size: 11px; color: #9a958f; }
        .col .ghost { height: 14px; }
        .col-card {
          display: grid; gap: 3px; padding: 8px 9px; border-radius: 8px; background: linear-gradient(160deg, #2c2926, #24211f);
          border: 1.5px solid rgba(176, 128, 66, 0.28); transition: border-color 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .col-card.lit { border-color: rgba(176, 128, 66, 0.72); }
        .col-card .card-id { font-size: 11px; }
        .col-card .card-title { font-size: 12.5px; line-height: 1.25; }
        /* Under the boards: the light shows in the gutters and ends at each board, never across its text. */
        .traces { inset: 0; z-index: 0; }
        .board { z-index: 1; }
        .flow { width: auto; margin: 64px 20px 0; gap: 72px; padding-bottom: 72px; }
        .panel { padding: 24px 20px; border-radius: 12px; gap: 22px; }
        .gaps { grid-template-columns: 1fr; }
        .gaps > div, .gaps > div + div { padding: 18px 0 6px; border-left: 0; border-bottom: 1px solid #222; }
        .loop { grid-template-columns: 1fr; }
        .transcript { position: static; }
        .recipes li { grid-template-columns: 1fr; gap: 4px; }
        .paths { grid-template-columns: 1fr; }
        /* The role table becomes one block per tracker, each state labelled with its role. */
        .table-wrap { border: 0; overflow: visible; }
        .roles, .roles tbody, .roles tr, .roles th, .roles td { display: block; min-width: 0; }
        .roles thead { display: none; }
        .roles tr { border: 1px solid #262626; border-radius: 10px; margin-bottom: 12px; overflow: hidden; }
        .roles th, .roles td { white-space: normal; border-bottom: 1px solid #222; }
        .roles td { display: flex; justify-content: space-between; gap: 16px; }
        .roles td::before { content: attr(data-role); color: var(--quiet); }
        .roles td.on::before { color: var(--amber); }
        .foot { width: auto; margin: 0 20px; }
      }
    </style>
  </body>
</html>
